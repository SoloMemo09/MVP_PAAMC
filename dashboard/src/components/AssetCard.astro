---
export interface Props {
  asset: {
    id: string;
    ip_address: string;
    mac_address: string;
    vendor: string | null;
    created_at: string;
  }
}

const { asset } = Astro.props;
const fallbackVendor = asset.vendor && asset.vendor !== 'Desconocido' ? asset.vendor : 'Unknown Vendor';
---

<a href={`/asset/${asset.id}`} class="group relative bg-[#1a1924] rounded-2xl p-5 border border-[#2d2c3c] hover:border-purple-500/50 transition-all duration-300 hover:shadow-lg hover:shadow-purple-500/10 hover:-translate-y-1 block overflow-hidden">
  <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-purple-400 transform rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7" />
    </svg>
  </div>

  <div class="relative z-10 flex flex-col h-full">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-purple-500/10 flex items-center justify-center text-purple-400 border border-purple-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-white group-hover:text-purple-400 transition-colors">{asset.ip_address}</h3>
          <p class="text-xs text-gray-500 font-medium truncate max-w-[140px]">{fallbackVendor}</p>
        </div>
      </div>
    </div>
    
    <div class="mt-auto pt-4 border-t border-[#2d2c3c]/50">
      <div class="flex items-center justify-between text-xs">
        <span class="text-gray-400 font-mono bg-black/20 px-2 py-1 rounded-md">{asset.mac_address || 'No MAC'}</span>
        <span class="text-purple-400/80 group-hover:text-purple-400 font-medium flex items-center gap-1">
          Details
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
