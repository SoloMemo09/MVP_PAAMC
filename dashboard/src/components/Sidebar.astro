---
const currentPath = Astro.url.pathname;

const menuItems = [
  { name: 'Dashboard', path: '/', icon: 'dashboard-icon' },
  { name: 'Topology', path: '/topology', icon: 'topology-icon' },
];
---

<aside class="w-20 lg:w-64 bg-[#14131b] border-r border-[#2d2c3c] flex flex-col items-center lg:items-start py-8 transition-all duration-300 z-10 sticky top-0 h-screen">
  <div class="px-0 lg:px-8 mb-12 w-full flex justify-center lg:justify-start items-center">
    <!-- Logo placeholder -->
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-purple-500/20">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
      </svg>
    </div>
    <span class="ml-4 text-xl font-bold tracking-tight text-white hidden lg:block">PAAMC<span class="text-purple-500">.</span></span>
  </div>

  <nav class="flex-1 w-full flex flex-col gap-2 px-3 lg:px-4">
    {menuItems.map(item => {
      const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
      return (
        <a 
          href={item.path} 
          class={`flex items-center justify-center lg:justify-start px-0 lg:px-4 py-3 lg:py-3.5 rounded-xl transition-all group relative overflow-hidden ${
            isActive 
              ? 'bg-purple-500/10 text-purple-400 font-medium' 
              : 'text-gray-400 hover:bg-[#1f1e2b] hover:text-gray-200'
          }`}
        >
          {isActive && (
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-8 bg-purple-500 rounded-r-full"></div>
          )}
          
          <!-- Icons based on name -->
          {item.name === 'Dashboard' ? (
            <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${isActive ? 'text-purple-500' : 'group-hover:text-gray-300'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${isActive ? 'text-purple-500' : 'group-hover:text-gray-300'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          )}
          
          <span class="ml-4 hidden lg:block">{item.name}</span>
        </a>
      )
    })}
  </nav>

  <div class="px-4 w-full mt-auto hidden lg:block">
    <div class="p-5 rounded-2xl bg-gradient-to-b from-[#1a1924] to-[#121118] border border-[#2d2c3c] shadow-lg">
      <p class="text-sm font-medium text-gray-300 mb-2">Network Scanner</p>
      
      <button id="open-scan-modal" class="w-full py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        New Scan
      </button>
    </div>
  </div>
</aside>

<!-- Scan Modal -->
<div id="scan-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
  <div class="bg-[#1a1924] border border-[#2d2c3c] rounded-2xl p-6 w-full max-w-md shadow-2xl transform scale-95 transition-transform duration-300" id="scan-modal-content">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-bold text-white">Start Network Scan</h3>
      <button id="close-scan-modal" class="text-gray-400 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-400 mb-1">Target CIDR</label>
      <input type="text" id="scan-cidr" value="192.168.1.0/24" class="w-full bg-[#0f0e13] border border-[#2d2c3c] text-white rounded-lg px-3 py-2 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-colors" />
    </div>

    <div id="scan-feedback" class="text-sm mb-4 hidden rounded-lg p-3"></div>
    
    <div class="flex justify-end gap-3 mt-6">
      <button id="cancel-scan-btn" class="px-4 py-2 text-sm font-medium text-gray-300 hover:text-white transition-colors">Cancel</button>
      <button id="run-scan-btn" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
        <svg id="scan-spinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Run Scan
      </button>
    </div>
  </div>
</div>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  
  const openModalBtn = document.getElementById('open-scan-modal');
  const closeModalBtn = document.getElementById('close-scan-modal');
  const cancelBtn = document.getElementById('cancel-scan-btn');
  const runScanBtn = document.getElementById('run-scan-btn');
  const modal = document.getElementById('scan-modal');
  const modalContent = document.getElementById('scan-modal-content');
  const cidrInput = document.getElementById('scan-cidr') as HTMLInputElement;
  const feedback = document.getElementById('scan-feedback');
  const spinner = document.getElementById('scan-spinner');

  function openModal() {
    modal.classList.remove('hidden');
    // slight delay for transition
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
    }, 10);
  }

  function closeModal() {
    modal.classList.add('opacity-0');
    modalContent.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      if (feedback) feedback.classList.add('hidden');
    }, 300);
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

  if (runScanBtn) {
    runScanBtn.addEventListener('click', async () => {
      const cidr = cidrInput.value.trim();
      if (!cidr) return;

      runScanBtn.setAttribute('disabled', 'true');
      runScanBtn.classList.add('opacity-70', 'cursor-not-allowed');
      spinner.classList.remove('hidden');
      feedback.classList.add('hidden');

      try {
        const response = await fetch(`${API_URL}/scan/run`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cidr })
        });
        
        const data = await response.json();

        feedback.classList.remove('hidden', 'bg-red-500/10', 'text-red-400');
        feedback.classList.add('bg-green-500/10', 'text-green-400');
        
        if (response.ok) {
          feedback.innerHTML = `<strong>Success!</strong> ${data.mensaje}. The process is running in the background. Refresh this page in a minute to see results.`;
        } else {
          feedback.classList.remove('bg-green-500/10', 'text-green-400');
          feedback.classList.add('bg-red-500/10', 'text-red-400');
          feedback.innerHTML = `<strong>Error!</strong> ${data.error || 'Failed to start scan.'}`;
        }
      } catch (err) {
        feedback.classList.remove('hidden', 'bg-green-500/10', 'text-green-400');
        feedback.classList.add('bg-red-500/10', 'text-red-400');
        feedback.innerHTML = `<strong>Error!</strong> Could not connect to the API.`;
      } finally {
        runScanBtn.removeAttribute('disabled');
        runScanBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        spinner.classList.add('hidden');
      }
    });
  }
</script>
