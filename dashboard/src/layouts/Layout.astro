---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="PAAMC Network Mapping Dashboard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#0f0e13] text-gray-200 font-sans antialiased min-h-screen flex selection:bg-purple-500/30">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0f0e13;
		--panel-bg: #1a1924;
		--primary-accent: #9f7aea; /* purple-500 */
		--secondary-accent: #f6ad55; /* orange-400 */
	}
	
	/* Custom scrollbar */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: #2d2c3c;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #3f3e53;
	}
</style>
