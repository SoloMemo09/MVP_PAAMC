---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import TopologyGraph from '../components/TopologyGraph.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

let assets = [];
let error = null;

try {
  const res = await fetch(`${API_URL}/assets`);
  if (res.ok) {
    assets = await res.json();
  } else {
    throw new Error('Failed to fetch assets');
  }
} catch (e) {
  error = e.message;
}
---

<Layout title="Network Topology">
  <Sidebar />
  
  <main class="flex-1 flex flex-col bg-[#0f0e13] h-screen overflow-hidden">
    <header class="px-8 lg:px-12 py-8 border-b border-[#2d2c3c] bg-[#1a1924]/50 backdrop-blur-md shrink-0">
      <h1 class="text-3xl font-bold text-white mb-2">Network Topology</h1>
      <p class="text-gray-400">Visual mapping of discovered assets and their relationships.</p>
    </header>

    <div class="flex-1 relative">
      {error ? (
        <div class="absolute inset-0 p-8">
          <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-6 text-red-400">
            <h3 class="font-bold text-lg mb-2">Error Loading Topology</h3>
            <p>{error}</p>
          </div>
        </div>
      ) : assets.length === 0 ? (
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center text-gray-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <p>No assets discovered to visualize.</p>
          </div>
        </div>
      ) : (
        <TopologyGraph assets={assets} />
      )}
    </div>
  </main>
</Layout>
