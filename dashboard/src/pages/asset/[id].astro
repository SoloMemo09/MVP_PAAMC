---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';

export const prerender = false; // Need SSR for dynamic ID fetching

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

let asset = null;
let error = null;

try {
  const res = await fetch(`${API_URL}/assets/${id}`);
  if (res.ok) {
    asset = await res.json();
  } else {
    throw new Error('Failed to fetch asset details');
  }
} catch (e) {
  error = e.message;
}
---

<Layout title={asset ? `Asset ${asset.ip_address}` : 'Asset Details'}>
  <Sidebar />
  
  <main class="flex-1 overflow-y-auto bg-[#0f0e13]">
    <div class="max-w-5xl mx-auto p-8 lg:p-12">
      <div class="mb-8">
        <a href="/" class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-purple-400 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Dashboard
        </a>
      </div>

      {error ? (
        <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-6 text-red-400">
          <h3 class="font-bold text-lg mb-2">Error</h3>
          <p>{error}</p>
        </div>
      ) : asset ? (
        <>
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-12">
            <div class="flex items-center gap-5">
              <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500/20 to-indigo-600/20 flex items-center justify-center border border-purple-500/30 text-purple-400 shadow-lg shadow-purple-500/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h1 class="text-3xl font-bold text-white mb-1">{asset.ip_address}</h1>
                <p class="text-gray-400">{asset.vendor && asset.vendor !== 'Desconocido' ? asset.vendor : 'Unknown Vendor'}</p>
              </div>
            </div>
            
            <div class="bg-[#1a1924] rounded-xl border border-[#2d2c3c] p-4 flex gap-8">
              <div>
                <p class="text-xs text-gray-500 font-medium mb-1">MAC Address</p>
                <p class="text-gray-200 font-mono text-sm">{asset.mac_address || 'N/A'}</p>
              </div>
              <div>
                <p class="text-xs text-gray-500 font-medium mb-1">First Seen</p>
                <p class="text-gray-200 text-sm">{new Date(asset.created_at).toLocaleDateString()}</p>
              </div>
            </div>
          </div>

          <h2 class="text-xl font-semibold text-white mb-6">Open Ports & Services</h2>
          
          {asset.ports && asset.ports.length > 0 ? (
            <div class="bg-[#1a1924] border border-[#2d2c3c] rounded-2xl overflow-hidden shadow-lg">
              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                  <thead class="bg-[#1f1e2b] text-xs uppercase text-gray-400 font-semibold">
                    <tr>
                      <th class="px-6 py-4">Port</th>
                      <th class="px-6 py-4">Protocol</th>
                      <th class="px-6 py-4">State</th>
                      <th class="px-6 py-4">Service Details</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[#2d2c3c]">
                    {asset.ports.map(port => (
                      <tr class="hover:bg-[#1f1e2b]/50 transition-colors">
                        <td class="px-6 py-4">
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-purple-500/10 text-purple-400 border border-purple-500/20">
                            {port.port_number}
                          </span>
                        </td>
                        <td class="px-6 py-4 text-gray-300">{port.protocol}</td>
                        <td class="px-6 py-4">
                          <span class={`inline-flex items-center gap-1.5 ${port.state === 'open' ? 'text-green-400' : 'text-gray-400'}`}>
                            {port.state === 'open' && <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>}
                            {port.state}
                          </span>
                        </td>
                        <td class="px-6 py-4 text-gray-400 font-mono text-xs max-w-xs truncate">
                          Unknown (Banner grabbing in DB table "services" not returned by API)
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <div class="bg-[#1a1924] border border-[#2d2c3c] rounded-2xl p-10 text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-600 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <p class="text-gray-400">No open ports recorded for this asset.</p>
            </div>
          )}
        </>
      ) : (
        <div class="flex justify-center items-center py-20">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-500"></div>
        </div>
      )}
    </div>
  </main>
</Layout>
