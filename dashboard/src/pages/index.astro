---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import AssetCard from '../components/AssetCard.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

let assets = [];
let latestScan = null;
let error = null;

try {
  const assetsRes = await fetch(`${API_URL}/assets`);
  if (assetsRes.ok) {
    assets = await assetsRes.json();
  } else {
    throw new Error('Failed to fetch assets');
  }

  const scanRes = await fetch(`${API_URL}/scan/latest`);
  if (scanRes.ok) {
    latestScan = await scanRes.json();
  }
} catch (e) {
  error = e.message;
}

// Stats
const totalAssets = assets.length;
const vendorsCount = new Set(assets.map(a => a.vendor).filter(v => v && v !== 'Desconocido')).size;
---

<Layout title="PAAMC Dashboard">
  <Sidebar />
  
  <main class="flex-1 overflow-y-auto bg-[#0f0e13]">
    <div class="max-w-7xl mx-auto p-8 lg:p-12">
      <header class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h1 class="text-3xl lg:text-4xl font-bold text-white mb-2">Network Dashboard</h1>
          <p class="text-gray-400">Overview of your scanned corporate network.</p>
        </div>
        
        {latestScan && (
          <div class="flex items-center gap-3 bg-[#1a1924] px-4 py-2.5 rounded-xl border border-[#2d2c3c]">
            <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></div>
            <div class="text-sm">
              <span class="text-gray-400 block text-xs">Last Scan</span>
              <span class="text-gray-200 font-medium">{new Date(latestScan.created_at).toLocaleString()}</span>
            </div>
          </div>
        )}
      </header>

      {error ? (
        <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-6 text-red-400 mb-8">
          <h3 class="font-bold text-lg mb-2">API Connection Error</h3>
          <p>Could not connect to the Node.js backend. Please ensure the API is running on port 3000.</p>
          <p class="text-sm mt-2 font-mono opacity-80">Details: {error}</p>
        </div>
      ) : (
        <>
          <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <!-- Stats Cards -->
            <div class="bg-gradient-to-br from-[#1a1924] to-[#121118] border border-[#2d2c3c] rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute right-0 top-0 w-32 h-32 bg-purple-500/5 rounded-full blur-2xl -mr-10 -mt-10"></div>
              <h3 class="text-gray-400 text-sm font-medium mb-1">Total Assets</h3>
              <p class="text-4xl font-bold text-white">{totalAssets}</p>
            </div>
            
            <div class="bg-gradient-to-br from-[#1a1924] to-[#121118] border border-[#2d2c3c] rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute right-0 top-0 w-32 h-32 bg-orange-500/5 rounded-full blur-2xl -mr-10 -mt-10"></div>
              <h3 class="text-gray-400 text-sm font-medium mb-1">Identified Vendors</h3>
              <p class="text-4xl font-bold text-white">{vendorsCount}</p>
            </div>
            
            <div class="bg-gradient-to-br from-[#1a1924] to-[#121118] border border-[#2d2c3c] rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute right-0 top-0 w-32 h-32 bg-blue-500/5 rounded-full blur-2xl -mr-10 -mt-10"></div>
              <h3 class="text-gray-400 text-sm font-medium mb-1">Network Range</h3>
              <p class="text-2xl font-bold text-white mt-1.5">{latestScan ? latestScan.cidr_range : 'N/A'}</p>
            </div>
          </section>

          <section>
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-xl font-semibold text-white">Discovered Devices</h2>
              <div class="relative">
                <input type="text" placeholder="Search IP or MAC..." class="bg-[#1a1924] border border-[#2d2c3c] text-sm text-gray-200 rounded-lg pl-10 pr-4 py-2 focus:outline-none focus:border-purple-500/50 transition-colors placeholder:text-gray-500" disabled />
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </div>
            
            {assets.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {assets.map(asset => (
                  <AssetCard asset={asset} />
                ))}
              </div>
            ) : (
              <div class="bg-[#1a1924] border border-[#2d2c3c] rounded-2xl p-12 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                <h3 class="text-lg font-medium text-gray-300">No assets found</h3>
                <p class="text-gray-500 mt-1">Run a scan using the Python CLI to populate this list.</p>
              </div>
            )}
          </section>
        </>
      )}
    </div>
  </main>

  <script>
    // Sistema de recarga "soft" (como htmx) para actualizar el dashboard
    // sin que la página parpadee ni se pierda el estado (como la búsqueda).
    let lastScanDate = null;
    let lastAssetsCount = null;

    async function checkForUpdates() {
      try {
        // Pedimos los datos puros a la API localmente
        const API_URL = 'http://localhost:3000';
        
        const [scanRes, assetsRes] = await Promise.all([
          fetch(`${API_URL}/scan/latest`),
          fetch(`${API_URL}/assets`)
        ]);

        if (scanRes.ok && assetsRes.ok) {
          const scan = await scanRes.json();
          const assets = await assetsRes.json();

          const currentScanDate = scan ? scan.created_at : null;
          const currentAssetsCount = assets ? assets.length : 0;

          // Guardar estado inicial en la primera ejecución
          if (lastScanDate === null && lastAssetsCount === null) {
            lastScanDate = currentScanDate;
            lastAssetsCount = currentAssetsCount;
            return;
          }

          // Si hubo un cambio (nuevo escaneo o nuevos activos)
          if (currentScanDate !== lastScanDate || currentAssetsCount !== lastAssetsCount) {
            lastScanDate = currentScanDate;
            lastAssetsCount = currentAssetsCount;
            
            console.log("Actualizando dashboard en tiempo real...");
            
            // Hacemos fetch a la propia página para obtener el HTML renderizado nuevo
            const htmlRes = await fetch(window.location.href);
            const htmlText = await htmlRes.text();
            
            const parser = new DOMParser();
            const doc = parser.parseFromString(htmlText, 'text/html');
            
            // Reemplazamos el contenido principal
            const currentMain = document.querySelector('main');
            const newMain = doc.querySelector('main');
            
            if (currentMain && newMain) {
              currentMain.innerHTML = newMain.innerHTML;
            }
          }
        }
      } catch (err) {
        console.error("Error en real-time updater:", err);
      }
    }

    // Comprobar actualizaciones cada 5 segundos
    setInterval(checkForUpdates, 5000);
    // Ejecutar inmediatamente para capturar el estado inicial
    checkForUpdates();
  </script>
</Layout>
